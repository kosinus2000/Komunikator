<Window x:Class="KomunikatorClient.MVVM.View.AddContactWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KomunikatorClient.MVVM.View"
        xmlns:viewModel="clr-namespace:KomunikatorClient.MVVM.ViewModel"
        xmlns:komunikator="clr-namespace:Komunikator"
        mc:Ignorable="d"
        Height="200" 
        Width="250"
        Title="MyChat"
        Window.Icon="../../Images/ChatGPT Image 25 maj 2025, 11_46_26 (1).png"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        ShowInTaskbar="True"
        Background="{x:Null}"
        d:DataContext="{d:DesignInstance Type=viewModel:MainViewModel, IsDesignTimeCreatable=True}">


    <Window.Resources>
        <ResourceDictionary>
            <Style TargetType="{x:Type Button}" x:Key="vanilla_button">
                <Setter Property="Margin"
                        Value="5" />
                <Setter Property="Cursor"
                        Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- Added ThemedTextBoxStyle -->
            <Style TargetType="{x:Type TextBox}" x:Key="ThemedTextBoxStyle">
                <Setter Property="Margin" Value="5" />
                <Setter Property="Padding" Value="5" />
                <Setter Property="Background" Value="#F3F9D2" />
                <Setter Property="BorderBrush" Value="#6A994E" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="Normal" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Nagłówek -->
        <Border Background="#B26A994E"
                CornerRadius="15,15,0,0">
            <Grid Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid x:Name="grdHeader"
                      PreviewMouseLeftButtonDown="UIElement_OnPreviewMouseLeftButtonDown"
                      Background="Transparent">
                    <Label
                        Content="MyChat"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Margin="10,0,0,0"
                        Foreground="#F2E8CF">
                    </Label>
                </Grid>

                <Grid Grid.Column="1" HorizontalAlignment="Right" Margin="0,0,20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding ElementName=grdHeader, Path=ActualHeight}" />
                        <ColumnDefinition Width="{Binding ElementName=grdHeader, Path=ActualHeight}" />
                        <ColumnDefinition Width="{Binding ElementName=grdHeader, Path=ActualHeight}" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="btnMinimize" Click="btnMinimize_Click" Style="{StaticResource vanilla_button}">
                        <Viewbox>
                            <Image Source="/Images/icons8-minimize-window-96.png"
                                   Opacity="0.8" />
                        </Viewbox>
                    </Button>
                    <Button x:Name="btnMaximize" Style="{StaticResource vanilla_button}"
                            Grid.Column="1">
                        <Viewbox>
                            <Image Source="/Images/icons8-maximize-window-96.png"
                                   Opacity="0.8" />
                        </Viewbox>
                    </Button>
                    <Button x:Name="btnClose" Style="{StaticResource vanilla_button}"
                            Grid.Column="2"
                            Click="btnExit_Click">
                        <Viewbox>
                            <Image Source="/Images/icons8-close-window-96.png"
                                   Opacity="0.8" />
                        </Viewbox>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- Miejsce na zawartość -->
        <Grid Grid.Row="1">
            <Border Background="#A7C957"
                    BorderBrush="#B36A994E"
                    BorderThickness="5,0,5,5"
                    CornerRadius="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="Dodaj kontakt!"
                               Foreground="#F3F9D2"
                               FontSize="16"
                               FontWeight="Bold"
                               Margin="0,20,0,10"
                               HorizontalAlignment="Center" />

                    <StackPanel Margin="0,0,0,5">
                        <Label Content="Nazwa użytkownika:"
                               Foreground="#F3F9D2"
                               FontSize="10"
                               VerticalAlignment="Bottom"
                               Height="22"
                               Margin="20,0,0,0"/>
                        <TextBox Width="200" Height="30"
                                 x:Name="UserNameRoundedTxtBoxRegistration"
                                 Style="{StaticResource ThemedTextBoxStyle}"
                                 Loaded="textBoxAddContact" />


                        <komunikator:RoundedButton Width="100"
                                                   Height="30"
                                                   ButtonContent="Dodaj"
                                                   CornerRadius="0,5,0,5"
                                                   Background="#F3F9D2"
                                                   BorderBrush="#6A994E"
                                                   BorderThickness="3"
                                                   FontSize="12"
                                                   FontWeight="DemiBold"
                                                   Foreground="#6A994E"
                                                   Margin="0,15,0,0"
                                                   Click="btnAddContact_Click" Loaded="RoundedButton_Loaded" />

                    </StackPanel>
                </StackPanel>

            </Border>
        </Grid>
    </Grid>
</Window>